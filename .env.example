# Стандарт: секреты — только в локальном .env (не коммитится).
# Скопируй: cp .env.example .env — и заполни реальными значениями в .env.
# В этом файле — только плейсхолдеры, никаких живых токенов.

# URL n8n-инстанса (тот же, что в AGENTS.md → Настройки проекта).
N8N_INSTANCE_URL=https://<инстанс>

# API-ключ инстанса (n8n → Settings → API). Живой ключ — только в .env.
N8N_API_KEY=<вставь-в-.env-не-коммитить>
