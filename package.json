{
  "name": "n8n-workflow-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "validate": "node scripts/validate-workflows.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check": "node scripts/validate-workflows.mjs && node scripts/check-skills.mjs",
    "skills:update": "pnpm dlx skills update -p -y",
    "skills:restore": "pnpm dlx skills experimental_install"
  }
}
